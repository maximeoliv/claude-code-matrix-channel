# --- Matrix homeserver + bot user (required) ---
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_USER_ID=@claudebot:example.com

# Either MATRIX_ACCESS_TOKEN_FILE (recommended, chmod 600) or MATRIX_ACCESS_TOKEN
MATRIX_ACCESS_TOKEN_FILE=
MATRIX_ACCESS_TOKEN=

# --- Authorisation (gate prompt injection — critical) ---
# Comma-separated Matrix user IDs allowed to push messages into your Claude session.
ALLOWED_SENDERS=@you:example.com

# Optional: restrict to specific rooms. Empty = any room where the bot is.
ALLOWED_ROOMS=

# Optional: Matrix room to receive Claude's permission prompts (Bash/Edit/etc.).
# When set, every tool call request is forwarded here. Reply "yes <id>" or "no <id>"
# in that room to allow/deny. Leave empty to disable permission relay.
ADMIN_ROOM_ID=

# --- Optional integrations ---
# Audio bridge for voice transcription (OpenAI-compatible /v1/audio/transcriptions).
# Used for m.audio messages. Leave default if you have audio-bridge on panels.
AUDIO_BRIDGE_URL=http://10.0.0.1:8889

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=
